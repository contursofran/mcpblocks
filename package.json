{
  "name": "registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run check:conformance && next build",
    "start": "next start",
    "lint": "next lint",
    "test:host": "node --test scripts/host.test.mjs",
    "test:hooks": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "check:conformance": "node scripts/check-conformance.mjs && node scripts/build-portable-styles.mjs --check && node --test scripts/portable-styles.test.mjs",
    "llms:build": "node scripts/generate-llms.mjs",
    "registry:build": "node scripts/build-portable-styles.mjs && shadcn build",
    "demo:build": "npm --prefix examples/deal-app run build && cp examples/deal-app/dist/view.html public/demo/deal-app.html",
    "worker:dev": "npx wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^3.0.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20.19.9",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.32.0",
    "eslint-config-next": "15.3.1",
    "happy-dom": "^20.14.6",
    "postcss": "^8.5.6",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.1.11",
    "tailwindcss-v3": "npm:tailwindcss@3.4.19",
    "typescript": "^5.9.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.2",
      "@types/react-dom": "19.1.2"
    }
  }
}
