{
  "name": "mcpblocks-deal-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Example MCP server that renders mcpblocks components as MCP App views.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-blocks": "node scripts/sync-blocks.mjs",
    "build": "npm run sync-blocks && tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "start:stdio": "tsx server/main.ts --stdio",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
