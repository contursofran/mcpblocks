{
  "name": "mcpblocks-view-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup:blocks": "shadcn add https://mcpblocks.dev/r/inline-card.json --yes && shadcn add https://mcpblocks.dev/r/host-harness.json --yes",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle.mjs",
    "start": "tsx server/index.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3001 --http-host-header 127.0.0.1:3001"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.9",
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "shadcn": "^3.0.0",
    "storybook": "^10.6.9",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
