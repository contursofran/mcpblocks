{
  // Static site (`pnpm build` writes it, incl. out/r/*.json) plus a Worker that serves the
  // demo MCP server at https://mcpblocks.dev/mcp. Serve /mcp with the Worker first.
  // Other requests look for a static asset and fall back to the Worker's 404.
  "name": "mcpblocks",
  "main": "./examples/deal-app/worker/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "run_worker_first": ["/mcp", "/mcp/*"]
  },
  // Required by `wrangler preview`, which Cloudflare runs for branch and PR builds.
  "previews": {}
}
